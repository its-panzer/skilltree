PORT=4783
HOST=127.0.0.1
# Jev credentials are loaded on the server only.
TYPESAFE_API_KEY=
# Optional: a separate local env file containing TYPESAFE_API_KEY.
TYPESAFE_ENV_FILE=
JEV_MODEL=jev-latest
# Required bearer token for HTTP MCP clients. Generate with: openssl rand -hex 32
SKILL_TREE_TOKEN=
# Exact HTTPS origin provided by Tailscale Serve, when configured.
SKILL_TREE_PUBLIC_ORIGIN=
# Tailscale account allowed to open the website through Serve.
TAILSCALE_ALLOWED_LOGIN=
# Optional path to a private data directory. Defaults to data/private.
SKILL_TREE_DATA_DIR=
